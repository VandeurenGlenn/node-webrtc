{
  "name": "@vandeurenglenn/wrtc",
  "description": "Standards-compliant WebRTC implementation for Node",
  "keywords": [
    "webrtc",
    "p2p",
    "peer"
  ],
  "type": "module",
  "version": "0.7.1",
  "author": "Alan K <ack@modeswitch.org> (http://blog.modeswitch.org)",
  "homepage": "https://github.com/VandeurenGlenn/node-webrtc",
  "bugs": "https://github.com/VandeurenGlenn/node-webrtc/issues",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VandeurenGlenn/node-webrtc.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "browser": "./lib/browser.js",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "browser": "lib/browser.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-cmake": "2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fidm/x509": "^1.2.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.1",
    "minimatch": "^10.2.6",
    "mocha": "^12.0.1",
    "rollup": "^4.34.6",
    "server-destroy": "^1.0.1",
    "simple-peer": "^9.11.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build:lib": "rollup -c",
    "build": "node scripts/build-from-source.js",
    "build:macos:node26": "./scripts/build-macos-node26.sh",
    "bench": "node benchmarks/run.js",
    "bench:baseline": "node benchmarks/run.js --output benchmarks/baseline.json",
    "bench:baseline:node26": "node benchmarks/run.js --output benchmarks/baseline-node26.json",
    "bench:baseline:stable": "node benchmarks/run.js --output benchmarks/baseline-stable.json --compare-runs 3",
    "bench:baseline:node26:stable": "node benchmarks/run.js --output benchmarks/baseline-node26-stable.json --compare-runs 3",
    "bench:compare": "node benchmarks/run.js --baseline benchmarks/baseline.json --fail-on-regression --regression-threshold 5",
    "bench:compare:node26": "node benchmarks/run.js --baseline benchmarks/baseline-node26.json --fail-on-regression --regression-threshold 5",
    "bench:compare:stable": "node benchmarks/run.js --baseline benchmarks/baseline-stable.json --fail-on-regression --regression-threshold 5 --compare-runs 3",
    "bench:compare:node26:stable": "node benchmarks/run.js --baseline benchmarks/baseline-node26-stable.json --fail-on-regression --regression-threshold 5 --compare-runs 3",
    "bench:profile:linux": "perf record -g --call-graph dwarf -- node benchmarks/run.js --scenario datachannel_binary_throughput_mib_per_second --iterations 5 --warmup 1 --throughput-messages 5000",
    "bench:profile:macos": "xcrun xctrace record --template 'Time Profiler' --launch -- node benchmarks/run.js --scenario datachannel_binary_throughput_mib_per_second --iterations 5 --warmup 1 --throughput-messages 5000",
    "install-example": "node scripts/install-example.js",
    "lint": "eslint benchmarks scripts test eslint.config.js rollup.config.js",
    "package-native-addon": "node scripts/package-native-addon.js",
    "test": "node --expose-gc --test --test-force-exit test/all.js",
    "test:electron": "electron test/electron",
    "wpt:init": "git submodule update --init --recursive",
    "wpt:reset": "node scripts/reset-wpt.js && npm run wpt:init",
    "wpt:test": "mocha test/web-platform-tests/run-wpts.js --exit",
    "wpt:update": "git submodule update --recursive --remote --force && cd test/web-platform-tests/tests && python wpt.py manifest --path ../wpt-manifest.json"
  }
}
